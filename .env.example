# ── LLM Provider ─────────────────────────────────────────────
# Set LLM_PROVIDER to one of: anthropic | openai | google | ollama
# Set LLM_MODEL to the matching model name for that provider.
#
# Provider        Recommended model         Notes
# ----------      -----------------------   ----------------------
# anthropic       claude-haiku-4-5-20251001      needs API key
# openai          gpt-4o-mini               needs API key
# google          gemini-2.0-flash          free tier available
# ollama          llama3.1:8b               100% local, no key

LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash

# API keys — only the key for your chosen provider is required
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GOOGLE_API_KEY=your_google_key_here

# Ollama — only needed if LLM_PROVIDER=ollama
# Default base URL assumes Ollama running locally
OLLAMA_BASE_URL=http://localhost:11434

# PostgreSQL
POSTGRES_USER=iga_user
POSTGRES_PASSWORD=iga_password
POSTGRES_DB=iga_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://iga_user:iga_password@localhost:5432/iga_db

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# LangSmith observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=iga-access-review
