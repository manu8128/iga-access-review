# LLM — pick one or both
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
LLM_PROVIDER=anthropic          # or "openai"
LLM_MODEL=claude-sonnet-4-6     # or gpt-4o

# PostgreSQL
POSTGRES_USER=iga_user
POSTGRES_PASSWORD=iga_password
POSTGRES_DB=iga_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://iga_user:iga_password@localhost:5432/iga_db

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# LangSmith observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=iga-access-review